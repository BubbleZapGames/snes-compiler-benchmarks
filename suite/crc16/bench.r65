// Bitwise CRC-16/CCITT-FALSE over 256 bytes.
#[lowram]
static mut BUF: [u8; 256];

#[inline(never)]
fn bench_init() {
    let mut v: u16 = 1;
    let mut i: u16 = 0;
    while i < 256 {
        v = (v << 2) + v + 0x3619;
        BUF[i] = (v >> 8) as u8;
        i = i + 1;
    }
}

#[inline(never)]
fn bench() -> u16 {
    let mut crc: u16 = 0xFFFF;
    let mut i: u16 = 0;
    while i < 256 {
        crc = crc ^ ((BUF[i] as u16) << 8);
        let mut b: u8 = 0;
        while b < 8 {
            if crc & 0x8000 != 0 {
                crc = (crc << 1) ^ 0x1021;
            } else {
                crc = crc << 1;
            }
            b = b + 1;
        }
        i = i + 1;
    }
    return crc;
}
