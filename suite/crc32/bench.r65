// CRC-32/CKSUM (without the length) of 1024 bytes, a bit at a time: 32-bit
// shifts and xors. The algorithm of c-bench-64's crc32.c, on generated input.
// R65 has no 32-bit integer, so the CRC is two u16 halves.
// Returns the 32-bit CRC folded to 16 bits.
#[lowram]
static mut DATA: [u8; 1024];

#[inline(never)]
fn bench_init() {
    let mut v: u16 = 1;
    let mut i: u16 = 0;
    while i < 1024 {
        v = (v << 2) + v + 0x3619;
        DATA[i] = (v >> 8) as u8;
        i = i + 1;
    }
}

#[inline(never)]
fn bench() -> u16 {
    let mut lo: u16 = 0;
    let mut hi: u16 = 0;
    let mut i: u16 = 0;
    while i < 1024 {
        hi = hi ^ ((DATA[i] as u16) << 8);
        let mut j: u8 = 8;
        while j != 0 {
            let top: u16 = hi & 0x8000;
            hi = hi << 1;                       // shift the pair left by one
            if (lo & 0x8000) != 0 {
                hi = hi | 1;
            }
            lo = lo << 1;
            if top != 0 {
                hi = hi ^ 0x04C1;               // polynomial 0x04C11DB7
                lo = lo ^ 0x1DB7;
            }
            j = j - 1;
        }
        i = i + 1;
    }
    return (~hi) ^ (~lo);
}
